# ─── Mediasoup (for SFU video classrooms) ──────────────
# MEDIASOUP_ANNOUNCED_IP=your-public-ip-or-domain

# ─── Optional — Google integrations (Gmail, Drive, Calendar) ─
# 1. Go to https://console.cloud.google.com → enable Gmail, Drive, Calendar APIs
# 2. Create OAuth 2.0 credentials (Desktop app type)
# 3. Get a refresh token via the OAuth playground:
#    https://developers.google.com/oauthplayground
#    Scopes needed:
#    - https://mail.google.com/
#    - https://www.googleapis.com/auth/drive.file
#    - https://www.googleapis.com/auth/calendar
# 4. Fill in below:
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REFRESH_TOKEN=xxx

# ─── Optional — AI & LLM ───────────────────────────────
# OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://...
