/* ATTENDANCE */
router.get("/v1/classroom-assessment/attendance", requireAuth, async (req, res) => {
  const user = getReqUser(req);
  if (!user || !isStaff(user.role)) return res.status(403).json({ message: "Forbidden" });
  try {
    const list = await db.select().from(attendanceSheets).orderBy(desc(attendanceSheets.date));
    return res.json({ data: list });
  } catch (err: any) {
    logger.error("GET attendance error: " + err.message);
    return res.status(500).json({ message: "Server error" });
  }
});

router.post("/v1/classroom-assessment/attendance", requireAuth, async (req, res) => {
  const user = getReqUser(req);
  if (!user || !isStaff(user.role)) return res.status(403).json({ message: "Forbidden" });
  try {
    const { courseId, date, rows } = req.body;
    const [sheet] = await db.insert(attendanceSheets).values({ courseId, date: new Date(date) }).returning();
    if (rows && Array.isArray(rows)) {
      for (const row of rows) {
        await db.insert(attendanceRows).values({ sheetId: sheet.id, studentId: row.studentId, status: row.status, note: row.note });
      }
    }
    return res.status(201).json({ data: sheet });
  } catch (err: any) {
    logger.error("POST attendance error: " + err.message);
    return res.status(500).json({ message: "Server error" });
  }
});

