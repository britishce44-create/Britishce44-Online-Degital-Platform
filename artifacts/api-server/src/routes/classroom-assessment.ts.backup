/* ENROLLMENTS */
router.post("/v1/enrollments", requireAuth, async (req, res) => {
  const user = getReqUser(req);
  if (!user || !isStaff(user.role)) return res.status(403).json({ message: "Forbidden" });
  try {
    const { studentId, courseId, classroomId } = req.body;
    if (!studentId || !courseId) return res.status(400).json({ message: "studentId and courseId required" });
    const [enrollment] = await db.insert(courseEnrollments).values({ studentId, courseId, classroomId, enrolledAt: new Date() }).returning();
    return res.status(201).json({ data: enrollment });
  } catch (err: any) {
    logger.error("POST enrollments error: " + err.message);
    return res.status(500).json({ message: "Server error" });
  }
});

router.get("/v1/enrollments/:studentId", requireAuth, async (req, res) => {
  const user = getReqUser(req);
  if (!user) return res.status(401).json({ message: "Unauthorized" });
  if (user.role === "student" && user.id !== req.params.studentId) return res.status(403).json({ message: "Forbidden" });
  try {
    const list = await db.select().from(courseEnrollments).where(eq(courseEnrollments.studentId, req.params.studentId));
    return res.json({ data: list });
  } catch (err: any) {
    logger.error("GET enrollments error: " + err.message);
    return res.status(500).json({ message: "Server error" });
  }
});

