/* USERS MANAGE */
router.get("/v1/users", requireAuth, async (req, res) => {
  const user = getReqUser(req);
  if (!user || !isStaff(user.role)) return res.status(403).json({ message: "Forbidden" });
  try {
    const list = await db.select().from(appUsers).orderBy(appUsers.id);
    return res.json({ data: list });
  } catch (err: any) {
    logger.error("GET users error: " + err.message);
    return res.status(500).json({ message: "Server error" });
  }
});

router.patch("/v1/users/:id/role", requireAuth, async (req, res) => {
  const user = getReqUser(req);
  if (!user || !isStaff(user.role)) return res.status(403).json({ message: "Forbidden" });
  try {
    const { role } = req.body;
    if (!role) return res.status(400).json({ message: "Role required" });
    const [updated] = await db.update(appUsers).set({ role, updatedAt: new Date() }).where(eq(appUsers.id, req.params.id)).returning();
    if (!updated) return res.status(404).json({ message: "Not found" });
    return res.json({ data: updated });
  } catch (err: any) {
    logger.error("PATCH users/role error: " + err.message);
    return res.status(500).json({ message: "Server error" });
  }
});

export default router;
