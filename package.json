{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"require('fs').existsSync('package-lock.json') && require('fs').unlinkSync('package-lock.json'); require('fs').existsSync('yarn.lock') && require('fs').unlinkSync('yarn.lock')\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "build:desktop": "powershell -File artifacts/desktop/build-desktop.ps1",
    "start:desktop": "pnpm --filter @workspace/britishce44-desktop run dev"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
